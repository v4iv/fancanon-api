{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fancanon-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "public",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "686529197cab41778e9017a8c5fc2066",
      "localConnectionString": "postgres://root:mysecretpassword@localhost:5432/local",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "queues": {
    "producers": [
      {
        "binding": "FANOUT_QUEUE",
        "queue": "fancanon-fanout-queue",
      },
    ],
    "consumers": [
      {
        "queue": "fancanon-fanout-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
    ],
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
}
