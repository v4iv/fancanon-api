{
  "name": "fancanon-api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:start": "docker compose up -d",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "DEBUG=* drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "auth:schema": "auth generate --config src/lib/auth/index.ts --output src/lib/db/schema/auth.schema.ts --yes"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "^1.6.25",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "postgres": "^3.4.9",
    "slug": "^12.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/slug": "^5.0.9",
    "auth": "^1.6.26",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "wrangler": "^4.110.0"
  }
}
