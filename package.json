{
  "name": "fancanon-api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify --outdir dist --upload-source-maps --var SENTRY_RELEASE:$(sentry-cli releases propose-version)",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:start": "docker compose up -d",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "DEBUG=* drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "auth:schema": "auth generate --config src/lib/auth/index.ts --output src/lib/db/schema/auth.schema.ts --yes",
    "sentry:sourcemaps": "_SENTRY_RELEASE=$(sentry-cli releases propose-version) && sentry-cli releases new $_SENTRY_RELEASE --org=fancanon --project=fancanon-api && sentry-cli sourcemaps upload --org=fancanon --project=fancanon-api --release=$_SENTRY_RELEASE --strip-prefix 'dist/..' dist",
    "postdeploy": "pnpm sentry:sourcemaps"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sentry/cloudflare": "^10.73.0",
    "@sentry/hono": "^10.73.0",
    "@valibot/to-json-schema": "^1.7.1",
    "better-auth": "^1.7.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "hono-openapi": "^1.3.2",
    "postgres": "^3.4.9",
    "slug": "^12.0.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "^3.7.0",
    "@types/node": "^26.4.1",
    "@types/slug": "^5.0.9",
    "@upstash/redis": "^1.38.4",
    "auth": "^1.7.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.69.0",
    "wrangler": "^4.129.0"
  }
}
